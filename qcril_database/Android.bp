filegroup {
    name: "rildb_other_sql_files",
    srcs: [
        "//vendor/xiaomi/sm8450-common:0_initial_qcrilnr",
        "//vendor/xiaomi/sm8450-common:1_version_intro_qcrilnr",
        "//vendor/xiaomi/sm8450-common:2_version_add_wps_config_qcrilnr",
        "//vendor/xiaomi/sm8450-common:3_version_update_wps_config_qcrilnr",
        "//vendor/xiaomi/sm8450-common:4_version_update_ecc_table_qcrilnr",
        "//vendor/xiaomi/sm8450-common:5_version_update_ecc_table_qcrilnr",
        "//vendor/xiaomi/sm8450-common:6_version_change_property_table_qcrilnr",
        "//vendor/xiaomi/sm8450-common:7_version_update_ecc_table_qcrilnr",
        "//vendor/xiaomi/sm8450-common:8_version_update_ecc_table",
        "//vendor/xiaomi/sm8450-common:9_version_update_ecc_table",
        "//vendor/xiaomi/sm8450-common:10_version_update_ecc_table",
        "//vendor/xiaomi/sm8450-common:11_version_update_ecc_table",
        "//vendor/xiaomi/sm8450-common:12_version_update_ecc_table",
    ],
}

filegroup {
    name: "rildb_config_sql_files",
    srcs: [
        "//vendor/xiaomi/sm8450-common:6.0_config",
        "//vendor/xiaomi/sm8450-common:7.0_config",
        "//vendor/xiaomi/sm8450-common:8.0_config",
        "//vendor/xiaomi/sm8450-common:9.0_config",
        "//vendor/xiaomi/sm8450-common:10.0_config",
        "//vendor/xiaomi/sm8450-common:11.0_config",
        "//vendor/xiaomi/sm8450-common:12.0_config",
        "//vendor/xiaomi/sm8450-common:13.0_config",
        "//vendor/xiaomi/sm8450-common:14.0_config",
        "config/15.0_config.sql",
        "config/15.1_config.sql",
        "config/15.2_config.sql",
    ],
}

genrule {
    name: "qcril_config_database",
    enabled: true,
    srcs: [
        ":rildb_other_sql_files",
        ":rildb_config_sql_files",
    ],
    tool_files: [
        "generate_db.sh",
    ],
    tools: [
        "sqlite3",
    ],
    cmd: "$(location generate_db.sh) $(location sqlite3) $(out) $(in)",
    out: ["qcrilNr.db"],
}

prebuilt_etc {
    name: "qcrilNrDb_vendor",
    filename: "qcrilNr.db",
    src: ":qcril_config_database",
    sub_dir: "qcril_database",
    vendor: true,
    required: [
        "0_initial_qcrilnr",
        "1_version_intro_qcrilnr",
        "2_version_add_wps_config_qcrilnr",
        "3_version_update_wps_config_qcrilnr",
        "4_version_update_ecc_table_qcrilnr",
        "5_version_update_ecc_table_qcrilnr",
        "6_version_change_property_table_qcrilnr",
        "7_version_update_ecc_table_qcrilnr",
        "8_version_update_ecc_table",
        "9_version_update_ecc_table",
        "10_version_update_ecc_table",
        "11_version_update_ecc_table",
        "12_version_update_ecc_table",
        "6.0_config",
        "7.0_config",
        "8.0_config",
        "9.0_config",
        "10.0_config",
        "11.0_config",
        "12.0_config",
        "13.0_config",
        "14.0_config",
        "15.0_config.sql",
        "15.1_config.sql",
        "15.2_config.sql",
    ],
}
